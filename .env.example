# Local `npm run dev` should stay on the JSON file even if `vercel env pull`
# dropped Blob tokens into .env.local.
SPARKBOARD_STORE=file

# Vercel production: created automatically when you attach a private Blob store.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Optional — Grok drafts on the call-sheet wire.
# XAI_API_KEY=

# Local `npm run dev` should stay on the JSON file even if `vercel env pull`
# dropped Blob tokens into .env.local.
SPARKBOARD_STORE=file
SPARKBOARD_DEV_SWITCHER=1

# Required to mint guest desks and GitHub sessions.
AUTH_SECRET=

# Optional GitHub OAuth (production desk). Two apps: localhost vs prod.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Optional. Fail-closed reset. Timing-safe header x-sparkboard-admin.
# SPARKBOARD_ADMIN_SECRET=

# Vercel production: created automatically when you attach a private Blob store.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Optional — Grok drafts on the call-sheet wire.
# XAI_API_KEY=
